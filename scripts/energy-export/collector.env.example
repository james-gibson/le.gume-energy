# Where the collector databases live on THIS machine.
#
# Copy to `collector.env` and fill in. The file is gitignored: the paths are
# machine-local and the export's own README says they are not published.
#
#   cp collector.env.example collector.env && chmod 600 collector.env
#
# Then `./install.sh` and the job will export, rebuild, and commit the new
# record at 06:20 every day.

SOLAREDGE_DB="$HOME/gpt/launchAgent/solaredge/solaredge.sqlite3"
XCEL_DB="$HOME/gpt/launchAgent/xcel/xcel-usage.sqlite3"

# Optional. Without it the daily production still exports and the normalized
# columns are blank.
ANALYSIS_DB="$HOME/gpt/launchAgent/analysis/analysis.sqlite3"
