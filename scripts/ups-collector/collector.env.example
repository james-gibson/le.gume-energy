# Where the UPSes and their store live on THIS machine.
#
# Copy to `collector.env` and fill in. The file is gitignored: the addresses
# and the store path are machine-local, and the collector's README says the
# published record never carries them.
#
#   cp collector.env.example collector.env && chmod 600 collector.env
#
# Then `./install.sh` and the agent will poll once a minute.

# One entry per unit: label=host. The label is stable identity; the address is
# not. A unit that does not answer is recorded as `unreachable`, and the other
# units are still polled — do not remove a unit because it is offline.
UPS_HOSTS="rack=192.168.1.10"
# ,spare=192.168.1.11

# Single-unit alternative, used only when UPS_HOSTS is empty.
# UPS_HOST="192.168.1.10"

# Read-only SNMP community on the RMCARD. The default is `public`; change it
# here if the card was configured with a different read community.
UPS_COMMUNITY="public"

UPS_PORT="161"
UPS_TIMEOUT="3"

# The shared store, beside the other collectors. One file holds every unit.
UPS_DB="$HOME/gpt/launchAgent/ups/ups.sqlite3"

# Seconds between polls.
UPS_INTERVAL="60"

# The record's clock. Override only if the record moves.
UPS_TZ="America/Denver"
